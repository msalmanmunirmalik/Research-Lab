# ============================================================
# DirectAdmin / cPanel production environment template
# ============================================================
# 1. Copy to `.env` on the server (never commit real secrets).
# 2. Replace every REPLACE_ME / your-domain value.
# 3. Build the frontend WITH VITE_API_URL set (Vite bakes it in at build time).
#
# Recommended layout (single Node app serves API + SPA):
#   SERVE_FRONTEND=true
#   VITE_API_URL=https://your-domain.com/api
#   FRONTEND_URL=https://your-domain.com

NODE_ENV=production
# DirectAdmin Node.js Selector usually injects PORT — leave or set to the assigned port
PORT=5002
TRUST_PROXY=true
SERVE_FRONTEND=true

# Public site origin(s) for CORS (comma-separated if you use www + apex)
FRONTEND_URL=https://your-domain.com

# REQUIRED: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_with_long_random_secret_at_least_32_chars
ENABLE_DEMO_AUTH=false
BCRYPT_ROUNDS=12
# REQUIRED for durable encrypted API keys: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_ME_64_hex_characters________________

# MySQL (create DB + user in DirectAdmin → MySQL Management)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_da_db_name
MYSQL_USER=your_da_db_user
MYSQL_PASSWORD=REPLACE_ME_db_password
MYSQL_SSL=false
# Optional single URL instead of discrete fields:
# MYSQL_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME

DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# AI (server-only — never put real keys in VITE_*)
# Platform Gemini powers included AI for testers (Google AI Studio free key works).
GEMINI_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
# Free included messages per user per UTC day on platform keys
PLATFORM_AI_DAILY_LIMIT=25

# Built into the browser bundle at `pnpm run build:frontend` time
VITE_API_URL=https://your-domain.com/api
VITE_GEMINI_API_KEY=

# Scholarly APIs (Evidence & References) — optional; improve rate limits
OPENALEX_MAILTO=research@your-domain.com
OPENALEX_API_KEY=
PROTOCOLS_IO_ACCESS_TOKEN=
SPRINGER_NATURE_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=research@your-domain.com
UNPAYWALL_EMAIL=research@your-domain.com
SEMANTIC_SCHOLAR_API_KEY=
# Scholar Sidekick — citation format / verify / retraction / export (optional ssk_ key)
SCHOLAR_SIDEKICK_API_KEY=
SCHOLAR_SIDEKICK_BASE_URL=
SCHOLARLY_CACHE_TTL_SEC=3600

LOG_LEVEL=info
