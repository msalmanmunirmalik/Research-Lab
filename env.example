# Server Configuration
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# REQUIRED: strong unique secret (32+ chars). App refuses to start with weak/example values.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Leave false for normal use and production. Playwright scripts set this true for E2E only.
ENABLE_DEMO_AUTH=false
DEMO_AUTH_TOKEN=use-a-strong-random-token-for-e2e-only
DEMO_AUTH_EMAIL=researcher@researchlab.com
DEMO_AUTH_PASSWORD=researcher123
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-64-character-hex-key
TRUST_PROXY=false
# When true (or NODE_ENV=production), Express also serves the Vite SPA from dist/
SERVE_FRONTEND=false

# Database Configuration (MySQL)
# Use MYSQL_URL for local development or leave it empty to fall back to individual fields.
MYSQL_URL=mysql://root:password@localhost:3306/digital_research_manager
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=digital_research_manager
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# AI & External Integrations (SERVER ONLY - never put secrets in VITE_* vars)
# Platform keys power included AI for testers (BYO keys still supported in Settings).
# GEMINI_API_KEY is used by the backend only — get a free key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional paid/backup platform key
OPENAI_API_KEY=
# Free included messages per user per UTC day when using platform keys (default 25)
PLATFORM_AI_DAILY_LIMIT=25
# Optional override (default gemini-3.6-flash)
GEMINI_CHAT_MODEL=gemini-3.6-flash
TOGETHER_API_KEY=
MATERIALS_PROJECT_API_KEY=
LENS_API_TOKEN=
PYTHON_STATS_SERVICE_URL=http://localhost:5003
REDIS_URL=

# Scholarly APIs (Evidence & References) — never commit real keys
# OpenAlex: polite pool email (mailto) improves rate limits; API key optional for higher limits
OPENALEX_MAILTO=research@digitalresearchmanager.com
OPENALEX_API_KEY=
# protocols.io client access token — public protocol read only. Never commit a real value.
PROTOCOLS_IO_ACCESS_TOKEN=
# Springer Nature Meta API key — protocol metadata only. Never commit a real value.
# SPRINGER_NATURE_METADATA_API_KEY is accepted as well. The open-access key is not used.
SPRINGER_NATURE_API_KEY=
# NCBI E-utilities — recommended for PubMed higher rate limits
NCBI_API_KEY=
NCBI_EMAIL=research@digitalresearchmanager.com
# Unpaywall — email required for polite API access
UNPAYWALL_EMAIL=research@digitalresearchmanager.com
# Semantic Scholar — optional recommendations / related works
SEMANTIC_SCHOLAR_API_KEY=
# Scholar Sidekick — citation format, fabrication verify, retraction, export
# Free anonymous tier works without a key; optional ssk_ key raises rate limits
# https://scholar-sidekick.com/account
SCHOLAR_SIDEKICK_API_KEY=
# Optional override (default https://scholar-sidekick.com)
SCHOLAR_SIDEKICK_BASE_URL=
# Search/metadata cache TTL seconds (default 3600)
SCHOLARLY_CACHE_TTL_SEC=3600

# Frontend (Vite) - public values only
# Use /api in local Vite (proxied to Express :5002). Production can also use /api same-origin.
VITE_API_URL=/api
VITE_GEMINI_API_KEY=

# Tooling & Automation (optional)
STRIPE_SECRET_KEY=
DONATION_PAYPAL_URL=
DONATION_CONTACT_EMAIL=support@digitalresearchmanager.com
GOOGLE_CLOUD_PROJECT_ID=
GITHUB_TOKEN=
